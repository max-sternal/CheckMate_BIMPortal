{
  "name": "checkmate-bimportal",
  "version": "0.4.1-beta",
  "private": true,
  "description": "CheckMate 0.4.1-beta — TypeScript & IFClite BIM Portal LOIN/IDS checker, 3D viewer, CLI and MCP App server",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "vitest run",
    "cli": "node packages/cli/bin/checkmate.mjs",
    "checkmate": "node packages/cli/bin/checkmate.mjs",
    "mcp": "node packages/mcp/bin/checkmate-mcp.mjs",
    "mcp:antigravity-plugin": "node scripts/build-antigravity-plugin.mjs",
    "models:generate": "node --import tsx scripts/generate-mini-models.ts",
    "web:dev": "pnpm --filter @checkmate/web dev",
    "web:build": "pnpm --filter @checkmate/web build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
