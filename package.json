{
  "name": "checkmate-bimportal",
  "version": "0.4.0",
  "private": true,
  "description": "CheckMate 0.4 — TypeScript & IFClite BIM Portal LOIN/IDS checker, 3D viewer, CLI and MCP App server",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "vitest run",
    "checkmate": "node --import tsx packages/cli/src/index.ts",
    "mcp": "node --import tsx packages/mcp/src/index.ts",
    "web:dev": "pnpm --filter @checkmate/web dev",
    "web:build": "pnpm --filter @checkmate/web build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
