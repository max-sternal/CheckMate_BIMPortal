# BIM Portal API Credentials and Configuration
# Copy this file to .env in your project root and fill in your credentials

# === Required Credentials ===
BIM_PORTAL_USERNAME=your_username_here
BIM_PORTAL_PASSWORD=your_password_here

# === CheckMate chat (optional) ===
# Only for the chat in the GUI. Without a key the chat stays inactive and says so;
# GUI, CLI and MCP server work unchanged. Requests are billed per token.
#ANTHROPIC_API_KEY=your_key_here

# Which model answers. Default: claude-opus-5-5 (Anthropic directly).
#CHECKMATE_LLM_MODEL=claude-haiku-5-5

# An endpoint other than Anthropic's own that speaks the same Messages format.
# OpenRouter serves models of many vendors behind one key; the model then needs
# its vendor as a prefix, and ANTHROPIC_API_KEY holds the OpenRouter key.
# Without the trailing /v1: the SDK appends v1/messages itself, exactly as it
# does to its own default https://api.anthropic.com. With it, the request goes
# to .../api/v1/v1/messages and comes back 404.
#CHECKMATE_LLM_BASE_URL=https://openrouter.ai/api
#CHECKMATE_LLM_MODEL=anthropic/claude-sonnet-4
#CHECKMATE_LLM_MODEL=tencent/hy4-flash
# openrouter/free is OpenRouter's free router: it picks a free model per request
# and filters for the features the request needs, tool calling among them. Free
# models are rate-limited and change often, so availability is not guaranteed.
# The chat then notes which model actually answered, since it differs per request.
#CHECKMATE_LLM_MODEL=openrouter/free

# === Logging Configuration ===
# Main log level: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL=DEBUG # Set to DEBUG for detailed logging during development


# === API Configuration ===
# Choose your environment: Production or Education
# Education environment -> for hackathon
#BIM_PORTAL_BASE_URL=https://via.bund.de/bmdv/bim-portal/edu/bim
# Production environment
BIM_PORTAL_BASE_URL=https://via.bund.de/bim

# === Timeout Configuration ===
REQUEST_TIMEOUT=60
CONNECT_TIMEOUT=10
MAX_RETRIES=3

# === Authentication Configuration ===
AUTH_RETRY_LIMIT=1
TOKEN_REFRESH_MARGIN_MINUTES=5
MAX_PROJECTS_TO_TEST=10

# === Export Configuration ===
EXPORT_DIRECTORY=exports
EXPORT_CLEANUP_DAYS=30

# === HTTP Client Configuration ===
VERIFY_SSL=true
FOLLOW_REDIRECTS=true



# Third-party library log levels (optional fine-tuning)
FEIGN_LOG_LEVEL=WARN
OKHTTP_LOG_LEVEL=WARN
JACKSON_LOG_LEVEL=WARN
SPRING_WEB_LOG_LEVEL=WARN
SPRING_SECURITY_LOG_LEVEL=WARN
SPRING_BOOT_LOG_LEVEL=WARN
SPRING_CONTEXT_LOG_LEVEL=WARN

# === Spring Boot Configuration ===
SERVER_PORT=8080
CONTEXT_PATH=/
SPRING_PROFILES_ACTIVE=default

# === Actuator/Monitoring Configuration ===
ACTUATOR_ENABLED=false
HEALTH_ENDPOINT_ENABLED=true
INFO_ENDPOINT_ENABLED=true
